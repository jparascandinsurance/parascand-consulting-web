# Railway runs Caddy to serve this static site when it sees a Caddyfile.
# Mirrors the Parascand Notary deployment pattern.
# Listens on the $PORT Railway provides; serves from the repo root.

:{$PORT} {
	root * .
	file_server
	encode gzip zstd
	try_files {path} {path}/ /index.html

	# Cache policy:
	# - Images/fonts: cached 1 day (rarely change).
	# - CSS/JS: cached 1 day, but busted by ?v=N version params on change.
	# - HTML (and extensionless pages): no-cache => browser revalidates every
	#   visit, so deploys show up immediately. Prevents stale-page bugs.
	@assets path_regexp \.(css|js|jpg|jpeg|png|webp|gif|svg|ico|woff|woff2)$
	header @assets Cache-Control "public, max-age=86400"

	# Sensible defaults
	header {
		?Cache-Control "no-cache"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}

	# Strip .html so /voice-ai works as well as /voice-ai.html
	@html_redirect {
		path_regexp html_redir ^/(.+)\.html$
	}
	redir @html_redirect /{re.html_redir.1} 301

	# Internally rewrite extensionless requests to their .html file
	@html_rewrite {
		not path /
		not path_regexp \.[a-zA-Z0-9]+$
	}
	rewrite @html_rewrite {path}.html
}
